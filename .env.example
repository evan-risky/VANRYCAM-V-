# ═══════════════════════════════════════════════════════════════════════
# Vanry Cam — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════
#
# CARA PAKAI:
#   1. Copy file ini: cp .env.example .env.local
#   2. Isi semua nilai placeholder dengan kredensial asli
#   3. JANGAN commit .env.local ke Git (sudah di-gitignore)
#
# CATATAN:
#   - File ini dibaca Next.js otomatis (dev & build).
#   - Untuk Prisma CLI (`npx prisma migrate ...`), .env.local juga dibaca
#     via prisma7.config.ts.
#   - Untuk script standalone (`npx tsx ...`), gunakan:
#       npx dotenv -e .env.local -- npx tsx ...
#     atau: npx tsx --env-file=.env.local ...
# ═══════════════════════════════════════════════════════════════════════


# ─── DATABASE ──────────────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Development (MySQL lokal WSL):
#   mysql://vanry_user:password@127.0.0.1:3306/vanrycam_dev
#
# Production (Coolify / VPS Docker network):
#   mysql://vanry_user:password@vanrycam-db:3306/vanrycam_prod
#
# Catatan:
#   - Gunakan 127.0.0.1 (bukan localhost) di WSL untuk paksa IPv4.
#   - Kalau password mengandung karakter khusus (@ : / # ?),
#     URL-encode dulu (contoh: @ → %40).
#   - Tambahkan ?ssl-mode=REQUIRED kalau pakai MySQL cloud (Aiven, dsb).
DATABASE_URL="mysql://vanry_user:VanryPasswordKuat@127.0.0.1:3306/vanrycam_dev"


# ─── SESSION ───────────────────────────────────────────────────────────
# Secret untuk sign & verify cookie admin (HMAC SHA-256).
# WAJIB di-set. Minimal 32 karakter acak.
#
# Generate via:
#   openssl rand -hex 32
# atau online: https://generate-secret.vercel.app/32
#
# JANGAN pakai nilai ini di production!
SESSION_SECRET="dev-secret-ganti-string-acak-panjang-minimal-32-char"


# ─── GOOGLE APPS SCRIPT (GAS) ──────────────────────────────────────────
# URL deployment GAS Web App untuk upload & list galeri.
# Format: https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
#
# Cara setup:
#   1. Buka https://script.google.com → project Vanry Cam
#   2. Paste docs/gas-gallery-full.gs ke Code.gs (gabungkan, jangan timpa)
#   3. Deploy → Manage deployments → Edit → New version → Deploy
#   4. Who has access: Anyone (BUKAN "Anyone with Google account")
#   5. Copy URL /exec → paste di bawah
#
# Verifikasi:
#   curl "$GAS_WEB_APP_URL?action=ping"
#   harus return JSON {"ok":true, ...}
#
# Kalau kosong:
#   - Upload kolase ke /kolase akan 502
#   - /galeri akan tampil "Galeri belum dikonfigurasi"
GAS_WEB_APP_URL="https://script.google.com/macros/s/AKfycby_RjDrgAg1hcnRDecBVpuLFy36Z7T2yoOQvCgiVLgrwiNPlIEpMIe-ncQHwCTeYo1bJg/exec"


# ─── APP URL ───────────────────────────────────────────────────────────
# URL publik aplikasi. Dipakai untuk:
#   - Link QR code di /admin/qr
#   - Metadata (og:url, canonical)
#   - Redirect callback
#
# ⚠️  Variabel NEXT_PUBLIC_* di-BAKE saat `npm run build`.
#     Kalau domain berubah, WAJIB rebuild (bukan hanya restart).
#
# Development:    http://localhost:3000
# Production:     https://domain-anda.com
# Coolify (sementara): http://<uuid>.<ip>.sslip.io
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ─── ADMIN SEED ────────────────────────────────────────────────────────
# Kredensial admin awal. Dipakai HANYA saat `npm run db:seed`.
#
# Setelah seed, user dibuat di tabel `users` dengan password ter-hash (scrypt).
# Perubahan di sini TIDAK mengubah password yang sudah ada — harus re-seed
# atau update manual via script.
#
# ⚠️  JANGAN pakai password lemah di production!
#     Kalau ADMIN_PASSWORD kosong, seed fallback ke "vanrycam-admin" (BAHAYA).
ADMIN_EMAIL="admin@vanrycam.local"
ADMIN_PASSWORD="AdminPasswordKuat"


# ─── NODE.JS (Production VPS / Coolify) ────────────────────────────────
# Batasi heap Node.js saat build & runtime, terutama di VPS RAM kecil.
#
# VPS 2GB:    --max-old-space-size=1536
# VPS 2GB (kalau build masih OOM): --max-old-space-size=1024
# VPS 4GB:    --max-old-space-size=3072
# Lokal (RAM > 8GB): (kosongkan atau tidak perlu)
#
# Uncomment di production:
# NODE_OPTIONS="--max-old-space-size=1536"